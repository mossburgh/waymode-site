{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waymode-site",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
    },
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "2026092001",
      "simple": { "limit": 240, "period": 60 },
    },
  ],
  "routes": [
    {
      "pattern": "waymode.ai",
      "custom_domain": true,
    },
    {
      "pattern": "www.waymode.ai",
      "custom_domain": true,
    },
  ],
  "main": "hosted/worker.ts",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHOWCASE",
        "class_name": "Showcase",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Showcase"],
    },
  ],
  "vars": {
    "DEMO_ENABLED": "true",
    "DEMO_BOOST_UNTIL": "2026-09-23T00:00:00Z",
  },
  "env": {
    "preview": {
      "name": "waymode-site-preview",
      "workers_dev": true,
      "routes": [],
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "2026092002",
          "simple": { "limit": 240, "period": 60 },
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SHOWCASE",
            "class_name": "Showcase",
          },
        ],
      },
      "vars": {
        "DEMO_ENABLED": "false",
      },
    },
  },
}
