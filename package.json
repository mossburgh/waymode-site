{
  "name": "waymode-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "node --env-file-if-exists=.env.local --import tsx demo/server.ts",
    "eval:public": "node demo/tools/eval-public.mjs",
    "record:public": "node demo/tools/record-public.mjs",
    "qa:public": "node demo/tools/qa-public.mjs",
    "eval:backend": "node --import tsx demo/tools/eval-backend.mjs",
    "eval:composed": "node demo/tools/eval-composed.mjs",
    "eval:completion": "node --import tsx demo/tools/eval-completion.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run format:check && npm run build && npm run check",
    "dev:hosted": "npm run build && wrangler dev",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "predeploy": "npm run build && npm run check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@mossburgh/waymode": "file:vendor/mossburgh-waymode-0.2.0.tgz",
    "@playwright/test": "^1.55.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^14.0.2",
    "ai": "7.0.105",
    "ghost-cursor-playwright": "^2.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.1",
    "globals": "17.12.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": "^22.22.1 || >=24"
  }
}
